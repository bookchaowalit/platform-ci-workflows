{
  "//": "Type-checks the plain-JS checker and its tests from their JSDoc (npm run typecheck, part of npm test).",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["check.mjs", "globals.d.ts", "test/*.mjs"]
}
